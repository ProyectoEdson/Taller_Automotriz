# Copiar a .env y sustituir USER:PASSWORD por credenciales locales de compose.yaml.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/taller_automotriz?schema=public"
# Generar un secreto aleatorio distinto por entorno; nunca usar vacío al ejecutar.
AUTH_SECRET=
AUTH_URL="http://127.0.0.1:3000"
